# Local WebDAV deployment credentials (T-014 deployment automation).
#
# Copy this file to `.env.deploy.local` (which is git-ignored) and enter the
# password locally. NEVER commit `.env.deploy.local`; it is parsed as data only
# (never sourced as shell code) and is never printed, bundled, or uploaded.
#
# Where to enter the password: in `.env.deploy.local`, on the `WEBDAV_PASSWORD=`
# line only (no quotes, no surrounding spaces, no shell `$()`/`${}`).
#
# The cPanel Web Disk account is restricted to public_html with read/write.

WEBDAV_URL=https://sapiensmetric.eu:2078/
WEBDAV_USERNAME=webdav@sapiensmetric.eu
WEBDAV_PASSWORD=
