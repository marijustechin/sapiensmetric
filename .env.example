# Local development only — non-production values. Copy to .env and change.
# Never commit .env or real credentials.

# MySQL (Docker Compose — T-004)
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=sapiensmetric_dev
MYSQL_USER=sapiensmetric_app
MYSQL_PASSWORD=change-me-app

# API database connection (reuses the non-root Compose user)
DB_HOST=127.0.0.1
DB_PORT=3307

# Local Nest API listener port (1-65535). Production may sit behind a reverse
# proxy, so this need not equal the public API URL port.
API_PORT=3000

# Web origin used for CORS and as PUBLIC_APP_URL. PUBLIC_APP_URL and
# CORS_ORIGIN must be the same canonical origin.
CORS_ORIGIN=http://localhost:3001

# Auth
JWT_SECRET=change-me-jwt-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_SESSION_TTL_DAYS=30

# SMTP (T-006 — generic authenticated SMTP; placeholders only, no real values)
SMTP_HOST=change-me-smtp-host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=change-me-smtp-user
SMTP_PASSWORD=change-me-smtp-password
SMTP_FROM=change-me-sender@example.test
SMTP_TEST_RECIPIENT=change-me-smoke-recipient@example.test

# Action-token lifetimes (seconds)
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800

# Public application configuration (T-006 — no secrets; never put a secret in
# any NEXT_PUBLIC_ variable)
# PUBLIC_APP_URL is the web/browser origin used in email links; it must be the
# same canonical origin as CORS_ORIGIN.
PUBLIC_APP_URL=http://localhost:3001
# NEXT_PUBLIC_API_BASE_URL is the browser-visible API base URL used by the
# static pages. For direct local development it must point at the running API
# listener (the API_PORT above).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# T-007 — Google OAuth/OpenID Connect (optional).
# Leave all three absent/commented to keep Google sign-in disabled; password
# authentication is unaffected. GOOGLE_REDIRECT_URI must exactly match an
# Authorized redirect URI in the Google Cloud Console, e.g.
#   http://localhost:3334/auth/google/callback
# Never commit real values; keep them only in the ignored root .env.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3334/auth/google/callback
