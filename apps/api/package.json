{
  "name": "@sapiensmetric/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migration:run": "tsx src/database/migrate.ts",
    "migration:show": "tsx src/database/migrate-status.ts",
    "tokens:cleanup": "tsx src/database/cleanup-action-tokens.ts",
    "smtp:smoke": "tsx src/smtp-smoke.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@fastify/cookie": "9.4.0",
    "@fastify/cors": "9.0.1",
    "@nestjs/common": "10.4.6",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.6",
    "@nestjs/platform-fastify": "10.4.6",
    "@nestjs/typeorm": "10.0.2",
    "@sapiensmetric/contracts": "workspace:*",
    "argon2": "0.41.1",
    "dotenv": "16.4.5",
    "fastify": "4.28.1",
    "jsonwebtoken": "9.0.2",
    "mysql2": "3.11.5",
    "nodemailer": "6.9.16",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "typeorm": "0.3.20",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "10.4.6",
    "@types/jsonwebtoken": "9.0.7",
    "@types/nodemailer": "6.4.16",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  }
}
